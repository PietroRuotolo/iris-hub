// Modelos do banco (MongoDB). Endereço em MONGO_URI (.env da raiz).
// Prisma 6: a linha 7+ ainda não suporta MongoDB. O MongoDB precisa ser replica set (o Atlas já é).

generator client {
  provider = "prisma-client-js"
  // native: a máquina de quem roda; rhel-openssl-3.0.x: as funções da Vercel (Node 22).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URI")
}

/// Contas de usuário. O MongoDB chama estas estruturas de coleções, não tabelas.
model User {
  id    String @id @default(uuid(7)) @map("_id")
  nome  String
  email String @unique
  /// Quando a pessoa terminou de ver a história de introdução (obrigatória no primeiro acesso).
  historiaVistaEm DateTime?

  @@map("users")
}

/// Sessão de usuário autenticado, separada das sessões do jogo (`sessoes`).
model Session {
  id        String   @id @default(uuid(7)) @map("_id")
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

type Tela {
  larguraPx Int
  alturaPx  Int
}

/// Resultado de uma calibração do rastreamento ocular.
model Calibracao {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  participanteId      String?
  realizadaEm         DateTime
  pontosCalibracao    Int
  erroMedioPx         Float?
  erroMedioFracaoTela Float?
  tela                Tela

  @@map("calibracoes")
}

// ---------------------------------------------------------------------------------------------
// Jogo de ritmo. Resumos pequenos (tela, calibração, cinco fases) ficam embutidos na sessão; as
// tentativas por alvo crescem com o jogo e ficam numa coleção própria. Amostras contínuas do olhar
// e vídeo da webcam não são guardadas.

type TelaSessao {
  larguraPx Int
  alturaPx  Int
  polegadas Float?
  pxPorCm   Float?
}

type CalibracaoResumo {
  pontos           Int
  erroMedioPx      Float?
  qualidade        Float?
  coberturaValida  Float?
  distanciaMediaCm Float?
  oculos           Boolean?
  fracaoReflexo    Float?
  reflexoIgnorado  Boolean?
}

type FaseResumo {
  fase                     Int
  nome                     String
  alvosApresentados        Int
  acertos                  Int
  semResposta              Int
  rastreamentoInsuficiente Int
  pontuacao                Float
  coberturaRastreamento    Float?
}

/// Uma partida do jogo de ritmo (calibração + até cinco fases).
model Sessao {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  /// Id da conta (User.id); pseudônimo, sem dados pessoais na sessão.
  participanteId  String?
  iniciadaEm      DateTime          @default(now())
  concluidaEm     DateTime?
  /// EM_ANDAMENTO, CONCLUIDA ou CANCELADA
  status          String
  tela            TelaSessao
  calibracao      CalibracaoResumo?
  fases           FaseResumo[]
  pontuacaoTotal  Float?
  coberturaTotal  Float?
  versaoPontuacao String

  @@index([participanteId, iniciadaEm])
  @@map("sessoes")
}

/// Um alvo apresentado numa fase, com o resultado medido pelo site e os pontos calculados aqui.
model TentativaAlvo {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  sessaoId      String    @db.ObjectId
  fase          Int
  numeroAlvo    Int
  /// Posição normalizada (0 a 1) na tela
  alvoX         Float
  alvoY         Float
  raioPx        Float
  janelaMs      Int
  apresentadoEm DateTime
  batidaEm      DateTime
  respostaEm    DateTime?
  /// ACERTO, SEM_RESPOSTA ou RASTREAMENTO_INSUFICIENTE
  resultado     String
  latenciaMs    Int?
  erroTempoMs   Int?
  erroEspacial  Float?
  permanenciaMs Int?
  cobertura     Float
  /// Desvio médio do olhar em relação ao alvo na janela da batida (px; + = direita/baixo)
  desvioXPx     Int?
  desvioYPx     Int?
  pontuacao     Float

  @@index([sessaoId, fase])
  @@map("tentativas_alvo")
}

// ---------------------------------------------------------------------------------------------
// Jogo de reflexo (avaliação psicomotora de tempo de reação).
// As tentativas são guardadas diretamente embutidas na sessão, sem coleções extras.

type TentativaReflexo {
  rodada        Int
  tempoEsperaMs Int
  tempoReacaoMs Int?
  queimou       Boolean
  acionamento   String   // "MOUSE_CLICK", "SPACE_KEY" ou "ESP32_BUTTON"
}

model SessaoReflexo {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  participanteId String?
  iniciadaEm     DateTime           @default(now())
  concluidaEm    DateTime?
  status         String             // EM_ANDAMENTO, CONCLUIDA ou CANCELADA
  tempoMedioMs   Float?
  melhorTempoMs  Int?
  tentativas     TentativaReflexo[]

  @@index([participanteId, iniciadaEm])
  @@map("sessoes_reflexo")
}

// ---------------------------------------------------------------------------------------------
// Jogo das cores (Genius com ESP32). Uma partida guarda as rodadas embutidas: são poucas (a
// sequência cresce a cada acerto e o jogo acaba no primeiro erro), então não precisam de coleção
// própria. A pontuação final vem do ESP32; maior sequência e tempo médio o serviço recalcula.

type RodadaCores {
  rodada           Int
  tamanhoSequencia Int
  acertou          Boolean
  tempoRespostaMs  Int?
}

model SessaoCores {
  id                   String        @id @default(auto()) @map("_id") @db.ObjectId
  /// Id da conta (User.id); pseudônimo, sem dados pessoais na sessão.
  participanteId       String?
  iniciadaEm           DateTime      @default(now())
  concluidaEm          DateTime?
  /// EM_ANDAMENTO, CONCLUIDA ou CANCELADA
  status               String
  pontuacaoFinal       Float?
  maiorSequencia       Int?
  tempoRespostaMedioMs Float?
  rodadas              RodadaCores[]

  @@index([participanteId, iniciadaEm])
  @@map("sessoes_cores")
}

// ---------------------------------------------------------------------------------------------
// Resumo compartilhado: o link do QR code (aberto no celular, sem login) com a última partida
// encerrada de cada jogo. Guarda só o hash do token; as sessões ficam fixadas pelos ids.

model ResumoCompartilhado {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash       String   @unique
  participanteId  String
  /// Primeiro nome, para o cabeçalho do resumo no celular.
  nome            String?
  sessaoRitmoId   String?  @db.ObjectId
  sessaoReflexoId String?  @db.ObjectId
  sessaoCoresId   String?  @db.ObjectId
  criadoEm        DateTime @default(now())
  expiraEm        DateTime

  @@index([participanteId, criadoEm])
  @@map("resumos_compartilhados")
}
