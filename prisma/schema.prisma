// Modelos do banco (MongoDB). Endereço em MONGO_URI (.env da raiz).
// Prisma 6: a linha 7+ ainda não suporta MongoDB. O MongoDB precisa ser replica set (o Atlas já é).

generator client {
  provider      = "prisma-client-js"
  // native: a máquina de quem roda; rhel-openssl-3.0.x: as funções da Vercel (Node 22).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URI")
}

/// Contas dos jogadores (criadas em /cadastro; não há login: quem joga é escolhido no site).
/// O MongoDB chama estas estruturas de coleções, não tabelas.
model User {
  id       String  @id @default(uuid(7)) @map("_id")
  nome     String
  email    String  @unique
  /// Só os números, com DDD. Opcional no banco porque as contas antigas não têm; o cadastro exige.
  telefone String?

  reflexSessions ReflexSession[]
  colorSessions  ColorSession[]
  rhythmSessions RhythmSession[]
  gameResults    GameResult[]

  @@index([nome])
  @@map("users")
}

// --- Jogo do reflexo, "o mestre mandou" (ESP32) -------------------------------------------------
// Uma partida tem 5 fases; em cada uma o mestre manda APERTAR (press) ou NÃO APERTAR (hold).
// reflex_attempts é a fonte da verdade (uma por fase); reflex_sessions guarda o resultado consolidado.
// O site manda só o que mediu (a ordem, a espera, o tempo para responder e quando a pessoa apertou); o
// session-service calcula o resultado, os pontos e o consolidado (packages/contracts/src/reflexo.ts), sem
// confiar no site. Tempos em milissegundos. O MongoDB não tem CHECK nem chave estrangeira: os limites
// ficam na validação do serviço, e as relações são garantidas pelo Prisma.

enum ReflexSessionStatus {
  in_progress
  completed
  disqualified
  abandoned
}

/// A ordem do mestre: press = "APERTE!"; hold = "NÃO APERTE!".
enum ReflexCommand {
  press
  hold
}

/// success: apertou a tempo; held: segurou no "NÃO APERTE!"; timeout: não apertou no "APERTE!";
/// wrong_press: apertou no "NÃO APERTE!"; false_start: apertou antes da ordem (ou em menos de 100 ms).
enum ReflexAttemptResult {
  success
  held
  timeout
  wrong_press
  false_start
}

/// De onde veio o aperto.
enum ReflexInput {
  ESP32_BUTTON
  SPACE_KEY
  MOUSE_CLICK
}

/// Uma partida do reflexo: dados gerais e o resultado consolidado.
model ReflexSession {
  id                  String              @id @default(uuid(7)) @map("_id")
  playerId            String              @map("player_id")
  player              User                @relation(fields: [playerId], references: [id])
  status              ReflexSessionStatus @default(in_progress)
  inputSource         ReflexInput?        @map("input_source")
  totalAttempts       Int                 @default(0) @map("total_attempts")
  /// Fases certas: success + held.
  validAttempts       Int                 @default(0) @map("valid_attempts")
  falseStarts         Int                 @default(0) @map("false_starts")
  wrongPresses        Int                 @default(0) @map("wrong_presses")
  timeouts            Int                 @default(0)
  /// Soma dos pontos das fases (até 100 por fase: 0 a 500 numa partida completa).
  totalScore          Float               @default(0) @map("total_score")
  /// Média dos tempos das tentativas success; null enquanto não há nenhuma.
  averageTimeMs       Float?              @map("average_time_ms")
  bestTimeMs          Int?                @map("best_time_ms")
  standardDeviationMs Float?              @map("standard_deviation_ms")
  /// Versão da regra de pontos (VERSAO_PONTUACAO_REFLEXO em packages/contracts), para comparar partidas.
  scoringVersion      String              @default("mestre-v1") @map("scoring_version")
  startedAt           DateTime            @default(now()) @map("started_at")
  finishedAt          DateTime?           @map("finished_at")

  attempts    ReflexAttempt[]
  gameResults GameResult[]

  @@index([playerId, startedAt(sort: Desc)])
  @@map("reflex_sessions")
}

/// Uma fase do reflexo (uma ordem do mestre), inclusive os erros.
model ReflexAttempt {
  id             String              @id @default(uuid(7)) @map("_id")
  sessionId      String              @map("session_id")
  session        ReflexSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// A fase: 1 a 5.
  attemptNumber  Int                 @map("attempt_number")
  command        ReflexCommand
  /// Espera sorteada antes da ordem.
  waitTimeMs     Int?                @map("wait_time_ms")
  /// Tempo para apertar (ou para segurar) depois da ordem.
  windowMs       Int                 @map("window_ms")
  /// O que o site mediu: ms da ordem até o aperto (negativo = antes da ordem; null = não apertou).
  pressedAfterMs Int?                @map("pressed_after_ms")
  result         ReflexAttemptResult
  /// Da ordem ao botão, quando apertou depois da ordem; null nos outros casos.
  reactionTimeMs Int?                @map("reaction_time_ms")
  /// 0 a 100 (packages/contracts: pontuarRodada).
  score          Float               @default(0)
  createdAt      DateTime            @default(now()) @map("created_at")

  // Também serve de índice por session_id (é o prefixo).
  @@unique([sessionId, attemptNumber])
  @@map("reflex_attempts")
}

// --- Jogo das cores, em 5 fases (ESP32) -------------------------------------------------------
// Mesmo padrão do reflexo: color_rounds é a fonte da verdade (a sequência mostrada e as cores
// apertadas em cada fase) e color_sessions o resultado consolidado. O site manda só o que mediu; o
// resultado de cada fase, os pontos e o consolidado são calculados pelo session-service
// (packages/contracts/src/cores.ts). Os limites (5 fases, tamanhos 3 a 7, cores 0 a 4) ficam na
// validação do serviço, já que o MongoDB não tem CHECK.

enum ColorSessionStatus {
  in_progress
  completed
  abandoned
}

/// Com o que a pessoa jogou: os botões da caixa ou, no modo simulação, o clique e o teclado.
enum ColorInput {
  ESP32_BUTTON
  MOUSE_CLICK
  KEYBOARD
}

/// success: repetiu a sequência inteira a tempo; wrong_color: apertou uma cor fora da ordem;
/// timeout: o tempo da fase acabou antes de terminar.
enum ColorRoundResult {
  success
  wrong_color
  timeout
}

/// Uma partida das cores: dados gerais e o resultado consolidado.
model ColorSession {
  id                String             @id @default(uuid(7)) @map("_id")
  playerId          String             @map("player_id")
  player            User               @relation(fields: [playerId], references: [id])
  status            ColorSessionStatus @default(in_progress)
  inputSource       ColorInput?        @map("input_source")
  /// Soma dos pontos das fases (até 100 por fase: 0 a 500 numa partida completa).
  score             Int                @default(0)
  /// Fases certas.
  roundsCompleted   Int                @default(0) @map("rounds_completed")
  /// Fases em que apertou uma cor fora da ordem.
  totalErrors       Int                @default(0) @map("total_errors")
  /// Fases em que o tempo acabou.
  timeouts          Int                @default(0)
  /// A maior sequência repetida certa (0 se não acertou nenhuma).
  maxSequenceLength Int                @default(0) @map("max_sequence_length")
  /// Média de ms por cor, só das fases certas.
  averageMsPerColor Float?             @map("average_ms_per_color")
  /// Versão da regra de pontos (VERSAO_PONTUACAO_CORES em packages/contracts), para comparar partidas.
  scoringVersion    String             @default("fases-v1") @map("scoring_version")
  startedAt         DateTime           @default(now()) @map("started_at")
  finishedAt        DateTime?          @map("finished_at")

  rounds      ColorRound[]
  gameResults GameResult[]

  @@index([playerId, startedAt(sort: Desc)])
  @@map("color_sessions")
}

/// Uma fase das cores.
model ColorRound {
  id               String           @id @default(uuid(7)) @map("_id")
  sessionId        String           @map("session_id")
  session          ColorSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roundNumber      Int              @map("round_number")
  sequenceLength   Int              @map("sequence_length")
  /// A sequência mostrada e as cores que a pessoa apertou (para no primeiro erro). Cores de 0 a 4:
  /// cinza, amarelo, verde, vermelho, azul.
  expectedSequence Int[]            @map("expected_sequence")
  playerSequence   Int[]            @default([]) @map("player_sequence")
  /// Do começo da vez da pessoa até o último aperto; null se não apertou nada.
  responseTimeMs   Int?             @map("response_time_ms")
  result           ColorRoundResult
  /// 0 a 100 (packages/contracts: pontuarFaseCores).
  score            Int              @default(0)
  createdAt        DateTime         @default(now()) @map("created_at")

  // Também serve de índice por session_id (é o prefixo).
  @@unique([sessionId, roundNumber])
  @@map("color_rounds")
}


// --- Jogo de ritmo (rastreamento ocular) ------------------------------------------------------
// Partida → fases → alvos. rhythm_targets é a fonte da verdade; rhythm_phases e rhythm_sessions
// guardam os consolidados, calculados pelo session-service a partir dos alvos (não pelo site). Cada
// partida jogada é uma rhythm_session nova (o id é gerado pelo site no começo da partida: repetir o
// envio não duplica). Coberturas em percentual (0–100); notas de tempo e precisão em 0–1.
// Os limites do CHECK da proposta (fase 1–5, score do alvo por resultado, hits + misses +
// insufficient_tracking <= total_targets etc.) ficam na validação do serviço: o MongoDB não tem CHECK.

enum RhythmStatus {
  in_progress
  completed
  abandoned
}

enum RhythmTargetResult {
  hit
  no_response
  insufficient_tracking
}

/// Uma partida do jogo de ritmo: resultado consolidado das fases.
model RhythmSession {
  id                        String       @id @default(uuid(7)) @map("_id")
  playerId                  String       @map("player_id")
  player                    User         @relation(fields: [playerId], references: [id])
  status                    RhythmStatus @default(in_progress)
  /// Média das pontuações das fases jogadas (0–100); null sem nenhuma fase com dados válidos.
  totalScore                Float?       @map("total_score")
  /// Só as fases concluídas por inteiro (0–5).
  phasesCompleted           Int          @default(0) @map("phases_completed")
  totalHits                 Int          @default(0) @map("total_hits")
  totalMisses               Int          @default(0) @map("total_misses")
  totalInsufficientTracking Int          @default(0) @map("total_insufficient_tracking")
  /// Versão da fórmula de pontuação (VERSAO_PONTUACAO em packages/contracts), para comparar partidas.
  scoringVersion            String       @default("v1") @map("scoring_version")
  startedAt                 DateTime     @default(now()) @map("started_at")
  finishedAt                DateTime?    @map("finished_at")

  phases      RhythmPhase[]
  gameResults GameResult[]

  @@index([playerId, startedAt(sort: Desc)])
  @@map("rhythm_sessions")
}

/// Uma das 5 fases da partida.
model RhythmPhase {
  id                   String        @id @default(uuid(7)) @map("_id")
  sessionId            String        @map("session_id")
  session              RhythmSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  phaseNumber          Int           @map("phase_number")
  status               RhythmStatus  @default(in_progress)
  /// Média dos pontos dos alvos válidos (0–100); null se todos tiveram rastreamento insuficiente.
  score                Float?
  totalTargets         Int           @default(0) @map("total_targets")
  hits                 Int           @default(0)
  misses               Int           @default(0)
  insufficientTracking Int           @default(0) @map("insufficient_tracking")
  trackingCoverage     Float?        @map("tracking_coverage")
  /// Raio configurado da fase; o efetivo em px (ajustado pela calibração) fica em cada alvo.
  targetRadiusCm       Float         @map("target_radius_cm")
  beatIntervalMs       Int           @map("beat_interval_ms")
  startedAt            DateTime      @default(now()) @map("started_at")
  finishedAt           DateTime?     @map("finished_at")

  targets RhythmTarget[]

  // Também serve de índice por session_id (é o prefixo).
  @@unique([sessionId, phaseNumber])
  @@map("rhythm_phases")
}

/// A avaliação de um alvo.
model RhythmTarget {
  id                      String             @id @default(uuid(7)) @map("_id")
  phaseId                 String             @map("phase_id")
  phase                   RhythmPhase        @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  targetNumber            Int                @map("target_number")
  result                  RhythmTargetResult
  /// hit: 50–100 (só pelo ímã, a metade: 25–50); no_response: 0; insufficient_tracking: null (não
  /// entra na média da fase).
  score                   Float?
  /// Acerto só pelo ímã: o olhar ficou perto do alvo, não dentro dele (vale metade).
  byMagnet                Boolean            @default(false) @map("by_magnet")
  /// Centro do alvo, normalizado (0–1) na tela.
  targetX                 Float              @map("target_x")
  targetY                 Float              @map("target_y")
  /// Da aparição do alvo até o olhar entrar nele.
  latencyMs               Int?               @map("latency_ms")
  /// Entrada do olhar menos a batida (ms); negativo = entrou antes.
  entryOffsetMs           Int?               @map("entry_offset_ms")
  dwellTimeMs             Int?               @map("dwell_time_ms")
  averageCenterDistancePx Float?             @map("average_center_distance_px")
  targetRadiusPx          Float?             @map("target_radius_px")
  timeScore               Float?             @map("time_score")
  precisionScore          Float?             @map("precision_score")
  trackingCoverage        Float?             @map("tracking_coverage")
  createdAt               DateTime           @default(now()) @map("created_at")

  // Também serve de índice por phase_id (é o prefixo).
  @@unique([phaseId, targetNumber])
  @@map("rhythm_targets")
}

// --- Resultado geral (os três jogos) ----------------------------------------------------------
// Uma avaliação geral de um usuário, com até uma partida de cada jogo. Guarda as métricas de cada
// jogo na escala original e a pontuação geral normalizada (0–100); não é um acumulador vitalício.
//
// Diferença para o SQL da proposta: lá as três FKs são UNIQUE. No MongoDB, um índice único conta
// "sem valor" como valor repetido, então a segunda avaliação sem partida de reflexo já falharia.
// Por isso as relações são N:1 sem @unique, e o serviço garante que uma partida está em no máximo
// uma avaliação e que as três são do mesmo usuário. Os limites do CHECK também ficam no serviço.

enum GameResultStatus {
  in_progress
  completed
  abandoned
}

model GameResult {
  id              String           @id @default(uuid(7)) @map("_id")
  userId          String           @map("user_id")
  user            User             @relation(fields: [userId], references: [id])
  reflexSessionId String?          @map("reflex_session_id")
  reflexSession   ReflexSession?   @relation(fields: [reflexSessionId], references: [id])
  colorSessionId  String?          @map("color_session_id")
  colorSession    ColorSession?    @relation(fields: [colorSessionId], references: [id])
  rhythmSessionId String?          @map("rhythm_session_id")
  rhythmSession   RhythmSession?   @relation(fields: [rhythmSessionId], references: [id])
  /// Métricas de cada jogo na escala original (cópia do consolidado da partida).
  reflexAvgMs     Float?           @map("reflex_avg_ms")
  colorScore      Int?             @map("color_score")
  rhythmScore     Float?           @map("rhythm_score")
  /// Média das notas normalizadas (0–100) de cada jogo. A regra de normalização ainda não existe.
  totalScore      Float?           @map("total_score")
  status          GameResultStatus @default(in_progress)
  startedAt       DateTime         @default(now()) @map("started_at")
  finishedAt      DateTime?        @map("finished_at")

  @@index([userId, startedAt(sort: Desc)])
  @@index([reflexSessionId])
  @@index([colorSessionId])
  @@index([rhythmSessionId])
  @@map("game_results")
}
