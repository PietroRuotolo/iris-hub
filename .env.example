# Copie para .env e ajuste. Valores padrão servem para rodar tudo localmente.

# Portas dos serviços HTTP
API_GATEWAY_PORT=3001
USER_SERVICE_PORT=3002
SESSION_SERVICE_PORT=3003

# URLs internas (o gateway encaminha para os serviços)
USER_SERVICE_URL=http://localhost:3002
SESSION_SERVICE_URL=http://localhost:3003

# Banco de dados: endereço do MongoDB (obrigatório para o session-service).
# Ex.: MONGO_URI=mongodb+srv://usuario:senha@cluster.xxxxx.mongodb.net/irisDB
MONGO_URI=

# Chave já usada pelo api-gateway; as rotas internas do Next a enviam no header x-api-key
# (exceto GET /health). Gere uma com: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# NÃO use NEXT_PUBLIC_ para a chave: variáveis NEXT_PUBLIC_ vão para o navegador.
API_KEY=

# Front-end: endereço do gateway (usado no servidor Next e no navegador, se necessário)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Logs: debug | info | warn | error
LOG_LEVEL=info
