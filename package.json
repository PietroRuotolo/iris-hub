{
  "name": "iris-hub",
  "private": true,
  "scripts": {
    "dev:all": "nest build && concurrently --kill-others-on-fail -n build,session,gateway,user,worker,web -c gray,cyan,magenta,blue,yellow,green \"nest build --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=.env dist/apps/session-service/src/main.js\" \"node --watch --env-file-if-exists=.env dist/apps/api-gateway/src/main.js\" \"node --watch --env-file-if-exists=.env dist/apps/user-service/src/main.js\" \"node --watch --env-file-if-exists=.env dist/apps/analytics-worker/src/main.js\" \"npm run dev:web\"",
    "dev:web": "next dev apps/web",
    "dev:gateway": "nest start api-gateway --watch --exec \"node --env-file-if-exists=.env\"",
    "dev:user": "nest start user-service --watch --exec \"node --env-file-if-exists=.env\"",
    "dev:session": "nest start session-service --watch --exec \"node --env-file-if-exists=.env\"",
    "dev:worker": "nest start analytics-worker --watch --exec \"node --env-file-if-exists=.env\"",
    "build": "nest build && next build apps/web",
    "build:services": "nest build",
    "build:web": "next build apps/web",
    "start:web": "next start apps/web",
    "start:gateway": "node --env-file-if-exists=.env dist/apps/api-gateway/src/main.js",
    "start:user": "node --env-file-if-exists=.env dist/apps/user-service/src/main.js",
    "start:session": "node --env-file-if-exists=.env dist/apps/session-service/src/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/apps/analytics-worker/src/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migration:run": "prisma db push",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "mongodb-memory-server": "^11.3.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  }
}
